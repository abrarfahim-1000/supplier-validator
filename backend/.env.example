# Copy to .env and fill in locally. Never commit real values.
# Frontend variables are public: they must never contain secrets.
#
# The backend and evals/run_eval.py load .env on startup. Real environment variables win,
# and a missing file is fine (the hosted deployment injects variables instead).
# ENV_FILE=.env

# --- LLM extraction (backend only) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Reasoning models can spend minutes thinking before answering. "none" keeps a call inside
# the 60s budget; leave empty for endpoints that do not support the field.
LLM_REASONING_EFFORT=none

# --- Rules and purchase request ---
RULES_PATH=rules/company_rules.yaml

# --- API ---
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173
MAX_PDFS=20
MAX_FILE_MB=5
MAX_CONCURRENT_JOBS=2
JOB_TTL_SECONDS=3600
JOB_TIMEOUT_SECONDS=600
RATE_LIMIT_JOBS=10
RATE_LIMIT_WINDOW_SECONDS=60
TEMP_DIR_BASE=

# --- Frontend (build-time, public) ---
VITE_API_BASE_URL=http://localhost:8000
